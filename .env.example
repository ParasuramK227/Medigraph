# MediGraph Environment Variables

# --- Neo4j Configuration ---
# For Neo4j AuraDB (Cloud):
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# Or for local Neo4j:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# --- Groq AI API Key ---
# Used for clinical note extraction (LLM) and chatbot consultation queries.
GROQ_API_KEY=<your-groq-api-key>
# GROQ_API_KEY_EXTRACTION=<your-groq-api-key>
# GROQ_API_KEY_CHATBOT=<your-groq-api-key>

# --- AssemblyAI (Speech-to-Text & Live Streaming) ---
ASSEMBLYAI_API_KEY=<your-assemblyai-api-key>

# --- Server & Dev Settings ---
FLASK_DEBUG=1

# --- Auth / RBAC ---
# JWT signing secret (must be >= 32 chars in production; a dev fallback is used
# when unset). Rotation = issue new token after changing.
JWT_SECRET_KEY=<generate-a-long-random-secret>
# Minutes before an access token expires (default 60).
JWT_EXPIRATION_MINUTES=480
